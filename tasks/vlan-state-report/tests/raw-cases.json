    "raw_stdin": "{\"aps\":[],\"aps\":[]}",
    "expected": {
      "error": "invalid_input"
    }
  },
  {
    "id": "raw_nested_duplicate",
    "category": "raw_cli",
    "raw_stdin": "{\"aps\":[],\"x\":{\"a\":1,\"a\":2}}",
    "expected": {
      "error": "invalid_input"
    }
  },
  {
    "id": "raw_nan",
    "category": "raw_cli",
    "raw_stdin": "{\"aps\":[],\"x\":NaN}",
    "expected": {
      "error": "invalid_input"
    }
  },
  {
    "id": "raw_infinity",
    "category": "raw_cli",
    "raw_stdin": "{\"aps\":[],\"x\":Infinity}",
    "expected": {
      "error": "invalid_input"
    }
  },
  {
    "id": "raw_overflow",
    "category": "raw_cli",
    "raw_stdin": "{\"aps\":[],\"x\":1e999}",
    "expected": {
      "error": "invalid_input"
    }
  },
  {
    "id": "raw_root_null",
    "category": "raw_cli",
    "raw_stdin": "null",
    "expected": {
