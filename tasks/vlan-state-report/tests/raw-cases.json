      "snapshot": {
        "aps": [
          {
            "id": "a",
            "global_vlans": [
              {
                "name": "staff",
                "vlan_id": 27
              }
            ],
            "ssids": [
              {
                "name": "office",
                "config": {
                  "dva": true
                },
                "state": {
                  "dva": true
                }
              }
            ]
          }
        ]
      }
    }
