+// peerFor is the datapath peer that holds the counters of the station associated on addr.
+func (d *Driver) peerFor(addr string) (string, dp.PeerType) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if mld, ok := d.mld[addr]; ok {
+		return mld, dp.MLDPeer
+	}
+	return addr, dp.LinkPeer
+}
