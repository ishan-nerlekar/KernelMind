 // we can receive withdraws for such paths and withdrawals may not be
 // stopped by the same policies.
 func (dest *Destination) explicitWithdraw(logger log.Logger, withdraw *Path) *Path {
+	kept := dest.knownPathList[:0]
+	var removed *Path
+	for _, p := range dest.knownPathList {
+		if p.GetSource().Equal(withdraw.GetSource()) && p.GetNlri().PathIdentifier() == withdraw.GetNlri().PathIdentifier() {
+			removed = p
+			continue
+		}
+		kept = append(kept, p)
+	}
+	if removed != nil {
+		dest.knownPathList = kept
+		return removed
+	}
+	return dest.explicitWithdrawOne(logger, withdraw)
+}
